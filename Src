package com.newsapp;

import java.io.*;
import java.net.*;
import java.util.*;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

public class NewsFetcher {
    private static final String API_KEY = "0571636813e345b69d26ebdb44b44845";
    private static final String BASE_URL = "https://newsapi.org/v2/everything?";
    private static final Map<String, NewsCache> cache = new HashMap<>();
    private static final int CACHE_DURATION_MINUTES = 30;
    private static final DateTimeFormatter DATE_FORMATTER = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        while (true) {
            System.out.println("\n=== News Fetcher Application ===");
            System.out.println("1. Search news by keyword");
            System.out.println("2. View search history");
            System.out.println("3. Exit");
            System.out.print("Enter your choice: ");

            try {
                int choice = scanner.nextInt();
                scanner.nextLine();

                switch (choice) {
                    case 1:
                        searchNews(scanner);
                        break;
                    case 2:
                        displaySearchHistory();
                        break;
                    case 3:
                        System.out.println("Exiting application...");
                        scanner.close();
                        return;
                    default:
                        System.out.println("Invalid choice. Please try again.");
                }
            } catch (Exception e) {
                System.err.println("Error: " + e.getMessage());
                scanner.nextLine();
            }
        }
    }

    private static void searchNews(Scanner scanner) {
        System.out.print("Enter a keyword to search news (e.g., Sports, Business, Technology): ");
        String keyword = scanner.nextLine().trim().toLowerCase();

        if (keyword.isEmpty()) {
            System.out.println("Error: Keyword cannot be empty.");
            return;
        }

        if (cache.containsKey(keyword)) {
            NewsCache cachedResult = cache.get(keyword);
            if (!cachedResult.isExpired()) {
                System.out.println("\n=== Cached Results (from " + cachedResult.getTimestamp() + ") ===");
                displayNews(cachedResult.getNewsData());
                return;
            }
        }

        try {
            String apiUrl = BASE_URL + "q=" + URLEncoder.encode(keyword, "UTF-8") +
                    "&language=en&sortBy=publishedAt&pageSize=10&apikey=" + API_KEY;

            HttpURLConnection connection = (HttpURLConnection) new URL(apiUrl).openConnection();
            connection.setRequestMethod("GET");
            connection.setRequestProperty("User-Agent", "NewsFetcher/1.0");

            int responseCode = connection.getResponseCode();
            if (responseCode != 200) {
                handleErrorResponse(connection, responseCode);
                return;
            }

            StringBuilder response = new StringBuilder();
            try (BufferedReader reader = new BufferedReader(new InputStreamReader(connection.getInputStream()))) {
                String line;
                while ((line = reader.readLine()) != null) {
                    response.append(line);
                }
            }

            List<NewsArticle> newsList = parseJsonResponse(response.toString());
            if (newsList.isEmpty()) {
                System.out.println("No news found for keyword: " + keyword);
                return;
            }

            cache.put(keyword, new NewsCache(newsList));
            System.out.println("\n=== Latest News for '" + keyword + "' ===");
            displayNews(newsList);
            logSearch(keyword, newsList.size());

        } catch (Exception e) {
            System.err.println("Error fetching news: " + e.getMessage());
        }
    }

    private static List<NewsArticle> parseJsonResponse(String jsonResponse) {
        List<NewsArticle> newsList = new ArrayList<>();
        String[] articles = jsonResponse.split("\"articles\":\\[")[1].split("}]")[0].split("},\\{");

        for (String article : articles) {
            String title = extractJsonValue(article, "title");
            String description = extractJsonValue(article, "description");
            String url = extractJsonValue(article, "url");
            String publishedAt = extractJsonValue(article, "publishedAt");
            String source = extractJsonValue(article.split("\"source\":\\{")[1], "name");

            newsList.add(new NewsArticle(title, description, url, publishedAt, source));
        }
        return newsList;
    }

    private static String extractJsonValue(String json, String key) {
        try {
            String[] parts = json.split("\"" + key + "\":");
            if (parts.length < 2) return "N/A";

            String valuePart = parts[1].split(",")[0];
            if (valuePart.startsWith("\"")) {
                return valuePart.substring(1, valuePart.endsWith("\"") ? valuePart.length()-1 : valuePart.length());
            }
            return valuePart;
        } catch (Exception e) {
            return "N/A";
        }
    }

    private static void displayNews(List<NewsArticle> newsList) {
        for (int i = 0; i < newsList.size(); i++) {
            NewsArticle article = newsList.get(i);
            System.out.println("\n[" + (i+1) + "] " + article.getTitle());
            System.out.println("Source: " + article.getSource());
            System.out.println("Published: " + article.getFormattedDate());
            System.out.println("Description: " + article.getDescription());
            System.out.println("URL: " + article.getUrl());
        }
        System.out.println("\nTotal articles: " + newsList.size());
    }

    private static void handleErrorResponse(HttpURLConnection connection, int responseCode) throws IOException {
        try (BufferedReader errorReader = new BufferedReader(new InputStreamReader(connection.getErrorStream()))) {
            String errorLine;
            StringBuilder errorResponse = new StringBuilder();
            while ((errorLine = errorReader.readLine()) != null) {
                errorResponse.append(errorLine);
            }
            System.err.println("API Error: " + errorResponse.toString());
        }
    }

    private static void logSearch(String keyword, int resultCount) {
        try (FileWriter writer = new FileWriter("search_history.log", true)) {
            writer.write(LocalDateTime.now().format(DATE_FORMATTER) + " | Search: " + keyword +
                    " | Results: " + resultCount + "\n");
        } catch (IOException e) {
            System.err.println("Warning: Could not log search history.");
        }
    }

    private static void displaySearchHistory() {
        try (BufferedReader reader = new BufferedReader(new FileReader("search_history.log"))) {
            String line;
            System.out.println("\n=== Search History ===");
            while ((line = reader.readLine()) != null) {
                System.out.println(line);
            }
        } catch (IOException e) {
            System.out.println("No search history available yet.");
        }
    }
}

class NewsCache {
    private final List<NewsArticle> newsData;
    private final LocalDateTime timestamp;
    private static final long CACHE_DURATION_MINUTES = 30;

    public NewsCache(List<NewsArticle> newsData) {
        this.newsData = newsData;
        this.timestamp = LocalDateTime.now();
    }

    public List<NewsArticle> getNewsData() {
        return newsData;
    }

    public String getTimestamp() {
        return timestamp.format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss"));
    }

    public boolean isExpired() {
        return LocalDateTime.now().isAfter(timestamp.plusMinutes(CACHE_DURATION_MINUTES));
    }
}

class NewsArticle {
    private final String title;
    private final String description;
    private final String url;
    private final String publishedAt;
    private final String source;

    public NewsArticle(String title, String description, String url, String publishedAt, String source) {
        this.title = title;
        this.description = description;
        this.url = url;
        this.publishedAt = publishedAt;
        this.source = source;
    }

    public String getTitle() { return title; }
    public String getDescription() { return description; }
    public String getUrl() { return url; }
    public String getSource() { return source; }

    public String getFormattedDate() {
        try {
            LocalDateTime date = LocalDateTime.parse(publishedAt.substring(0, 19));
            return date.format(DateTimeFormatter.ofPattern("MMM dd, yyyy hh:mm a"));
        } catch (Exception e) {
            return publishedAt;
        }
    }
}
